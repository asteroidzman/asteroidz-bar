// ! Auto-generated file. Do not edit directly.
//
// This is the TEMPLATE. matugen renders it to ~/.config/asteroidz/colors.kdl on
// every wallpaper change, and asteroidz's config sources that.
//
// Nine colours, each pinned to a Material role. The settings window's Palette
// page edits this mapping and rewrites this file, so hand edits here are lost the
// next time it is used — change it there, or stop using the page.
//
// The four state colours (maximize, scratchpad, global, overlay) are deliberately
// absent: they default to focus-color, which is what keeps a themed border the
// same hue when a window is maximized.

layout {
    // Borders share the native UI palette: the resting border uses the theme's
    // resting surface and the focused border its focus colour, so a border and a
    // titlebar read as one material. Urgent stays on `error`; the gradient pairs
    // primary with tertiary.
    border {
        // Desaturated rather than the raw Material tone. surface_container_high
        // still carries a visible hue tint from the seed colour, which reads as
        // too colourful for something meant to recede.
        color 0x{{colors.surface_container_high.default.hex | to_color | grayscale | format: "hex_stripped"}}ff
        focus-color 0x{{colors.primary.default.hex_stripped}}ff
        urgent-color 0x{{colors.error.default.hex_stripped}}ff
        gradient { color2 0x{{colors.tertiary.default.hex_stripped}}ff }
    }
}

// Every native overlay: the monocle tab bar, titlebars, window-group bars,
// jump-mode labels, the screenshot UI.
theme {
    bg-color 0x{{colors.surface_container_high.default.hex | to_color | grayscale | format: "hex_stripped"}}ff
    fg-color 0x{{colors.on_surface.default.hex_stripped}}ff
    focus-bg-color 0x{{colors.primary.default.hex_stripped}}ff
    focus-fg-color 0x{{colors.on_primary.default.hex_stripped}}ff
    urgent-color 0x{{colors.error.default.hex_stripped}}ff
}
