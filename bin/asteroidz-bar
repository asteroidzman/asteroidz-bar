#!/bin/sh
# Launch the shell in the compositor's coordinate space.
#
# This exists because of one number. asteroidz renders every label through
# Pango at a FIXED 96 dpi times the output's scale (text-node.c:
# `pango_cairo_context_set_resolution(ctx, 96.0 * scale)`), so `theme { font
# "Ubuntu 16" }` is 16pt at 96dpi -- 21.33 logical pixels -- on every machine.
#
# Qt does not work that way. It reads QT_FONT_DPI / Xft.dpi / the desktop's
# text-scaling-factor and scales the WHOLE scene by the ratio, and this desktop
# sets 168 dpi. The first headless run came out at exactly 168/96 = 1.75x: a
# 48px bar drawn 84px tall. Nothing in the config was wrong; Qt was answering a
# question the compositor had already answered differently.
#
# So the DPI knobs are pinned and only the OUTPUT scale is left to do its job
# -- which is right, and is the same scale the compositor applies. A HiDPI
# monitor still gets a sharp bar; it just gets one the same size as the
# compositor's own.
#
# Unset rather than overridden where possible: QT_WAYLAND_FORCE_DPI=physical is
# not the same as absent, and absent is what we want.
unset QT_WAYLAND_FORCE_DPI
unset QT_SCREEN_SCALE_FACTORS
export QT_FONT_DPI=96
export QT_SCALE_FACTOR=1
export QT_AUTO_SCREEN_SCALE_FACTOR=0
export QT_ENABLE_HIGHDPI_SCALING=0
export QT_QPA_PLATFORM=wayland

# QT_QPA_PLATFORMTHEME is deliberately LEFT ALONE.
#
# Unsetting it looked right -- this shell takes its fonts and colours from the
# compositor, not from the desktop's Qt theme -- and it broke the tray. The
# platform theme is also where Qt gets its ICON theme, so without it every
# tray item resolved to nothing: `Could not load icon "dialog-information"`,
# drawn as a magenta placeholder.
#
# Nothing leaks in that matters: every label in the shell sets its family, size
# and weight explicitly from the compositor's theme, and the shell uses no Qt
# Quick Controls, so there is no palette to override.

SHELL_QML="${ASTEROIDZ_BAR_SHELL:-@SHELLDIR@/shell.qml}"

# Where `import Asteroidz.Bar` is found: the C++ module that draws the
# wallpaper and answers "does this file exist".
#
# Its own directory rather than /usr/lib/qt6/qml, so this package does not
# write into Qt's tree and does not break when Qt is rebuilt. Both spellings
# are set because Qt reads both, and the existing value is kept: a developer
# running against a build tree prepends to it.
QMLDIR="${ASTEROIDZ_BAR_QML:-@SHELLDIR@/qml}"
export QML_IMPORT_PATH="${QML_IMPORT_PATH:+$QML_IMPORT_PATH:}$QMLDIR"
export QML2_IMPORT_PATH="${QML2_IMPORT_PATH:+$QML2_IMPORT_PATH:}$QMLDIR"

# Absolute path, never a bare name: a launcher that resolves its own payload
# through PATH is one PATH edit away from executing itself.
exec /usr/bin/qs -p "$SHELL_QML" "$@"
