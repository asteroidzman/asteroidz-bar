#!/usr/bin/env python3
"""Reminders as an asteroidz bar plugin: scheduled tasks, done or skipped.

Replaces the compositor's built-in `medication` module (its name, not ours). The store is

    $XDG_STATE_HOME/asteroidz-bar/reminders.json

It used to be $XDG_STATE_HOME/waybar-medication/medications.json -- named for a
bar that no longer runs, and for a narrower job than this now does.

The store is the reason this belongs outside the compositor. Reading it means a
stat() on every arrange and a JSON parse whenever it changes, and WRITING it --
which taking a occurrence does -- means a rewrite-and-rename in the process that owns
the screen. None of that is compositor work, and the file is small enough that
a plugin polling it costs nothing.

    bar {
        modules-right "custom/reminders,volume,clock"
        custom "reminders" { exec "asteroidz-bar-reminders"
                             continuous true }
    }

Left-click lists today's tasks; picking one offers Done, Skip and Postpone.
The same menu adds, edits and removes the reminders themselves.

TEXT ENTRY happens in the popover. A menu row marked `input` is an editable
field: the compositor already sees every keystroke while a menu is up, so a
form is rows like any other content. No dialog, no second toolkit, no window
that is not part of the bar -- and activating a row hands back every field's
contents at once, so a four-field schedule arrives as one event.
"""

import json
import os
import sys
import threading
import time
import uuid
from datetime import datetime, timedelta, timezone

ICON = "asteroidz-bar/reminders.svg"

# What a finished task is called, in the menu and on disk -- the same word in
# both, now that the store is this plugin's own rather than one inherited from
# a medication tracker.
STATUS_WORD = {"done": "done", "skipped": "skipped"}
POLL_SECONDS = 20
POSTPONE_MINUTES = int(os.environ.get("ASTEROIDZ_REMINDER_POSTPONE") or "15")
# How long after its time a occurrence still counts as due rather than missed. Matches
# the built-in module's window.
DUE_WINDOW_HOURS = 12

lock = threading.Lock()
occurrences = []          # [{key,name,time,scheduled,status,postponed_until,due}]
menu_level = None   # None = top, otherwise the occurrence key being shown


def store_path():
    state = os.environ.get("XDG_STATE_HOME")
    base = state if state else os.path.join(os.path.expanduser("~"), ".local/state")
    return os.path.join(base, "asteroidz-bar", "reminders.json")


def migrate_doc(doc):
    """Rename a store written when this was a medication plugin.

    Renaming the plugin's vocabulary renamed its KEYS, and a document is not a
    variable: nothing in the file changed when the source did. Without this,
    doc.get("reminders") on an old store returns nothing, the plugin shows an
    empty list -- and the next save writes that empty list back over however
    long the user has been keeping it. Silent, and unrecoverable.

    Done on every read rather than as a one-shot upgrade, because the old file
    is still the file: a machine that syncs this store from another one still
    running the previous version needs converting every time, not once.

    `dosage` is dropped rather than renamed. It only ever meant "500mg", and
    there is nothing general it becomes.
    """
    if not isinstance(doc, dict) or "medications" not in doc:
        return doc

    def rename_id(v):
        return "rem-" + v[len("med-"):] \
            if isinstance(v, str) and v.startswith("med-") else v

    out = dict(doc)
    out["reminders"] = []
    for m in doc.get("medications") or []:
        if not isinstance(m, dict):
            continue
        r = {k: v for k, v in m.items() if k != "dosage"}
        if "id" in r:
            r["id"] = rename_id(r["id"])
        out["reminders"].append(r)
    out.pop("medications", None)

    # Keyed "<id>@<when>", so the id half has to move with the reminder it
    # names -- a key still saying med-3 matches nothing afterwards, and its
    # history is orphaned as thoroughly as if it had been deleted.
    occ = {}
    for key, v in (doc.get("doseState") or {}).items():
        head, sep, tail = key.partition("@")
        nkey = rename_id(head) + sep + tail
        if isinstance(v, dict):
            v = dict(v)
            if "medId" in v:
                v["reminderId"] = rename_id(v.pop("medId"))
            if "takenAt" in v:
                v["at"] = v.pop("takenAt")
            if v.get("status") == "taken":
                v["status"] = "done"
        occ[nkey] = v
    out["occurrences"] = occ
    out.pop("doseState", None)
    return out


def load_doc():
    try:
        with open(store_path()) as f:
            return migrate_doc(json.load(f))
    except (OSError, ValueError):
        return None


def save_doc(doc):
    """Atomic replace: write a sibling, fsync, rename.

    "Did I take it?" is answered from this file months later, so a half-written
    one is worse than a stale one -- the same reasoning the built-in module
    spells out.
    """
    path = store_path()
    tmp = path + ".tmp"
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(tmp, "w") as f:
            json.dump(doc, f, indent=2)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
        return True
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        return False


def scheduled_today(reminder, day):
    """Is this reminder scheduled on `day`?"""
    start = reminder.get("startDate")
    if start:
        try:
            s = datetime.strptime(start[:10], "%Y-%m-%d").date()
            if day < s:
                return False
            unit = reminder.get("frequencyUnit", "days")
            # `frequencyValue` is the name the form WRITES and the name the
            # editor reads back. This read `frequency`, which nothing has ever
            # written, so it got the default 1 every time, never reached the
            # modulo below, and returned True unconditionally -- every reminder
            # fired every day whatever its interval said. An air filter set to
            # 30 days went off the day after it was created.
            #
            freq = int(reminder.get("frequencyValue", 1) or 1)
            if unit == "days" and freq > 1:
                return (day - s).days % freq == 0
        except ValueError:
            pass
    return True


def reload_occurrences():
    doc = load_doc()
    if doc is None:
        with lock:
            occurrences.clear()
        return
    today = datetime.now().date()
    daykey = today.strftime("%Y-%m-%d")
    occ_state = doc.get("occurrences") or {}
    now = datetime.now()
    out = []
    for reminder in doc.get("reminders") or []:
        if not scheduled_today(reminder, today):
            continue
        name = reminder.get("name", "")
        rid = reminder.get("id", name)
        for t in reminder.get("times") or []:
            key = f"{rid}@{daykey}T{t}"
            st = occ_state.get(key) or {}
            status = st.get("status", "")
            postponed = st.get("postponedUntil")
            try:
                sched = datetime.strptime(f"{daykey} {t}", "%Y-%m-%d %H:%M")
            except ValueError:
                continue
            eff = sched
            if postponed:
                try:
                    eff = datetime.fromisoformat(postponed.replace("Z", "+00:00"))
                    eff = eff.astimezone().replace(tzinfo=None)
                except ValueError:
                    pass
            done = status in ("done", "skipped")
            due = (not done and eff <= now
                   and now - eff < timedelta(hours=DUE_WINDOW_HOURS))
            out.append({"key": key, "name": name, "time": t, "scheduled": sched,
                        "status": status, "due": due,
                        "pending": not done and eff > now})
    out.sort(key=lambda d: d["time"])
    with lock:
        occurrences[:] = out


def render():
    with lock:
        ndue = sum(1 for d in occurrences if d["due"])
        nxt = next((d for d in occurrences if d["pending"]), None)
        due_one = next((d for d in occurrences if d["due"]), None)
        total = len(occurrences)
    if total == 0:
        # Nothing scheduled: the module has nothing to say, so it says nothing
        # rather than sitting there as an empty pill.
        return {"hidden": True}
    if ndue:
        text = due_one["name"] if ndue == 1 else f"{ndue} due"
        return {"icon": ICON, "text": text, "class": "urgent", "tint": "urgent",
                "tooltip": f"{ndue} task(s) due now"}
    if nxt:
        return {"icon": ICON, "text": nxt["time"], "tint": "fg",
                "tooltip": f"next task at {nxt['time']}: {nxt['name']}"}
    return {"icon": ICON, "tint": "dim", "tooltip": "all tasks done today"}


def iso_utc(dt):
    return dt.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def mark(key, status):
    doc = load_doc()
    if doc is None:
        return
    ds = doc.setdefault("occurrences", {})
    entry = ds.setdefault(key, {})
    entry["status"] = status
    entry.pop("postponedUntil", None)
    with lock:
        d = next((x for x in occurrences if x["key"] == key), None)
    if d:
        hist = doc.setdefault("history", [])
        hist.insert(0, {
            "reminderId": key.split("@", 1)[0],
            "name": d["name"],
            "scheduled": iso_utc(d["scheduled"]),
            "at": iso_utc(datetime.now()) if status == "done" else None,
            "status": status,
        })
        # capped exactly as the plugin that created this store capped it
        del hist[200:]
    save_doc(doc)


def clear(key):
    """Undo a take/skip: the occurrence goes back to pending."""
    doc = load_doc()
    if doc is None:
        return
    ds = doc.setdefault("occurrences", {})
    ds.pop(key, None)
    save_doc(doc)


def postpone(key):
    doc = load_doc()
    if doc is None:
        return
    ds = doc.setdefault("occurrences", {})
    ds.setdefault(key, {})["postponedUntil"] = iso_utc(
        datetime.now() + timedelta(minutes=POSTPONE_MINUTES))
    save_doc(doc)


def new_id():
    return "rem-" + uuid.uuid4().hex[:16]


def all_reminders():
    return (load_doc() or {}).get("reminders") or []


# The form's draft, held HERE rather than in the bar.
#
# Adding a time rebuilds the whole form, and a rebuild is the only way the bar
# can show a list that grew. So the draft has to survive it, and the plugin is
# the side that can hold it: the bar's rows are rebuilt from whatever this
# sends. `draft["times"]` is the list being assembled; everything else is read
# back out of `fields` on submit, because the bar carries those for us.
draft = {"times": [], "id": None, "fields": {}}


def days_in_month(year, month):
    if month == 2:
        leap = year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)
        return 29 if leap else 28
    return 30 if month in (4, 6, 9, 11) else 31


def form_rows(reminder=None):
    """A schedule as rows: a name to type, and numbers to choose.

    Times and dates are STEPPERS, not text. A menu row is a poor text field --
    no selection, no cursor -- and "8:0" or "2026-8-1" is only found to be
    wrong once the form is submitted and refused, with nothing to say which of
    the four fields was at fault. A bounded number cannot be entered wrongly.

    Labels stay short: a popover latches its width when it opens, so a form
    stepped into from a short menu has no more room than that menu had.
    """
    m = reminder or {}
    now = datetime.now()
    start = m.get("startDate") or now.strftime("%Y-%m-%d")
    try:
        sy, sm, sd = (int(x) for x in start.split("-"))
    except ValueError:
        sy, sm, sd = now.year, now.month, now.day

    # Whatever the form last held wins over the stored reminder.
    #
    # Adding a time rebuilds every row, and a rebuild without this puts the
    # name back to what it was and the steppers back to 08:00 -- so entering a
    # second time would silently undo the first thing you typed. The bar hands
    # the whole form back with every pick, so keeping the last one is all this
    # takes.
    f = draft["fields"]

    def pre(key, fallback):
        v = f.get(key)
        return str(v) if v not in (None, "") else str(fallback)

    rows = [
        {"text": "Name", "value": "name", "input": True,
         "edit": pre("name", m.get("name", ""))},
        {"text": "Hour", "value": "hour",
         "spin": {"min": 0, "max": 23, "pad": 2}, "edit": pre("hour", 8)},
        {"text": "Minute", "value": "minute",
         "spin": {"min": 0, "max": 55, "step": 5, "pad": 2},
         "edit": pre("minute", 0)},
        {"text": "+ add this time", "value": "addtime"},
    ]

    # The times already on the draft, each one its own row so each can go
    # again. Shown even when empty is not worth a row: an empty list says
    # itself by the absence of any.
    for t in draft["times"]:
        rows.append({"text": "   " + t + "   \u00d7", "value": "rmtime:" + t})

    rows += [
        {"separator": True},
        {"text": "Year", "value": "year",
         "spin": {"min": 2020, "max": 2100, "wrap": False},
         "edit": pre("year", sy)},
        {"text": "Month", "value": "month",
         "spin": {"min": 1, "max": 12, "pad": 2}, "edit": pre("month", sm)},
        # Always 1..31, and clamped on save to what the month really has.
        # The bar cannot know the month while the day is being spun -- it
        # sends nothing until a row is picked -- so 31 February is refused
        # where it is understood rather than prevented where it is not.
        {"text": "Day", "value": "day",
         "spin": {"min": 1, "max": 31, "pad": 2}, "edit": pre("day", sd)},
        {"text": "Every N days", "value": "freq",
         "spin": {"min": 1, "max": 60, "wrap": False},
         "edit": pre("freq", m.get("frequencyValue", 1) or 1)},
    ]
    return rows


def draft_load(reminder):
    """Start a draft from an existing reminder, or empty for a new one."""
    draft["times"] = list((reminder or {}).get("times") or [])
    draft["id"] = (reminder or {}).get("id")
    draft["fields"] = {}


def add_time(fields):
    """The hour and minute currently on the steppers, onto the list."""
    try:
        h = int(fields.get("hour") or 0)
        mi = int(fields.get("minute") or 0)
    except ValueError:
        return
    t = "%02d:%02d" % (max(0, min(23, h)), max(0, min(59, mi)))
    if t not in draft["times"]:
        draft["times"].append(t)
        draft["times"].sort()


def save_from_fields(fields, med_id=None):
    """Turn a submitted form into a reminder. Rejects rather than saves
    something unusable -- a reminder with no time would never fire."""
    name = (fields.get("name") or "").strip()

    # The list, plus whatever is on the steppers right now: adding one time
    # and pressing Save without pressing "+ add this time" first is the
    # obvious way to enter a once-a-day reminder, and refusing it would be
    # pedantry.
    times = list(draft["times"])
    if not times:
        add_time(fields)
        times = list(draft["times"])
    if not name or not times:
        return False

    def num(key, default, lo, hi):
        try:
            return max(lo, min(hi, int(fields.get(key) or default)))
        except ValueError:
            return default

    freq = num("freq", 1, 1, 60)
    year = num("year", datetime.now().year, 2020, 2100)
    month = num("month", datetime.now().month, 1, 12)
    day = num("day", datetime.now().day, 1, days_in_month(year, month))
    start = "%04d-%02d-%02d" % (year, month, day)

    doc = load_doc() or {"version": 1, "reminders": [], "occurrences": {},
                         "history": [], "snoozeMinutes": POSTPONE_MINUTES}
    reminders = doc.setdefault("reminders", [])
    for m in reminders:
        if med_id and m.get("id") == med_id:
            m.update(name=name, times=sorted(times), frequencyValue=freq,
                     frequencyUnit="days", startDate=start, enabled=True)
            break
    else:
        reminders.append({"id": med_id or new_id(), "name": name,
                     "times": sorted(times),
                     "frequencyValue": freq, "frequencyUnit": "days",
                     "startDate": start, "enabled": True})
    save_doc(doc)
    return True


def delete_reminder(reminder_id):
    doc = load_doc()
    if doc is None:
        return
    doc["reminders"] = [m for m in (doc.get("reminders") or [])
                          if m.get("id") != med_id]
    # its occurrence state goes too, or a deleted reminder keeps ticking
    doc["occurrences"] = {k: v for k, v in (doc.get("occurrences") or {}).items()
                        if not k.startswith(med_id + "@")}
    save_doc(doc)


def menu():
    global menu_level
    rows = []
    with lock:
        snapshot = list(occurrences)
        level = menu_level
    if level is None:
        if not snapshot:
            rows.append({"text": "nothing scheduled today", "value": "",
                         "enabled": False})
        for d in snapshot:
            mark_ch = {"done": "✓", "skipped": "–"}.get(
                d["status"], "●" if d["due"] else "○")
            # EVERY occurrence drills down, finished ones included -- you may want to
            # undo a mistaken "done", and a row that silently does nothing is
            # worse than one that opens a panel saying so.
            rows.append({"text": f"{mark_ch}  {d['time']}  {d['name']}",
                         "value": "d:" + d["key"], "submenu": True})
        rows.append({"separator": True})
        rows.append({"text": "Add reminder…", "value": "add",
                     "submenu": True})
        if all_reminders():
            rows.append({"text": "Manage reminders", "value": "manage",
                         "submenu": True})
        return {"menu": {"item": "", "rows": rows}}

    if level == "add":
        rows.append({"text": "New reminder", "value": "", "enabled": False})
        rows.append({"separator": True})
        rows += form_rows()
        rows.append({"separator": True})
        rows.append({"text": "Save", "value": "save:"})
        rows.append({"text": "‹  Cancel", "value": "back", "submenu": True})
        return {"menu": {"item": "", "rows": rows}}

    if level == "manage":
        rows.append({"text": "Reminders", "value": "", "enabled": False})
        rows.append({"separator": True})
        for m in all_reminders():
            rows.append({"text": f"{m.get('name','')}  "
                                 f"({', '.join(m.get('times') or [])})",
                         "value": "m:" + m.get("id", ""), "submenu": True})
        rows.append({"separator": True})
        rows.append({"text": "‹  Back", "value": "back", "submenu": True})
        return {"menu": {"item": "", "rows": rows}}

    if level.startswith("edit:"):
        rid = level[5:]
        reminder = next((m for m in all_reminders() if m.get("id") == rid), None)
        if not reminder:
            return {"menu": {"item": "", "rows": []}}
        rows.append({"text": f"Edit {reminder.get('name','')}", "value": "",
                     "enabled": False})
        rows.append({"separator": True})
        rows += form_rows(reminder)
        rows.append({"separator": True})
        rows.append({"text": "Save", "value": "save:" + rid})
        rows.append({"text": "Remove", "value": "rm:" + rid})
        rows.append({"text": "‹  Back", "value": "manage", "submenu": True})
        return {"menu": {"item": "", "rows": rows}}

    if level.startswith("m:"):
        menu_level = "edit:" + level[2:]
        return menu()

    d = next((x for x in snapshot if x["key"] == level), None)
    if not d:
        return {"menu": {"item": "", "rows": []}}
    rows.append({"text": f"{d['time']}  {d['name']}", "value": "",
                 "enabled": False})
    rows.append({"separator": True})
    if d["status"]:
        rows.append({"text": "marked " + STATUS_WORD.get(d["status"],
                                                        d["status"]),
                     "value": "", "enabled": False})
        rows.append({"text": "Undo", "value": "undo:" + d["key"]})
    else:
        rows.append({"text": "Done", "value": "take:" + d["key"]})
        rows.append({"text": "Skip", "value": "skip:" + d["key"]})
        rows.append({"text": f"Postpone {POSTPONE_MINUTES} min",
                     "value": "snooze:" + d["key"]})
    rows.append({"separator": True})
    rows.append({"text": "‹  All reminders", "value": "back",
                 "submenu": True})
    return {"menu": {"item": "", "rows": rows}}


def emit(obj, last=[None]):
    line = json.dumps(obj, sort_keys=True)
    if obj.get("menu") is None:
        if line == last[0]:
            return
        last[0] = line
    sys.stdout.write(line + "\n")
    sys.stdout.flush()


def exit_with_the_bar():
    """stdin closed: the bar is gone, so stop.

    A continuous plugin's stdin is a pipe from the bar, so EOF is unambiguous.
    Without this the process polls for ever -- 27 plugin processes were found
    running from five previous bar sessions, the oldest a day old.

    Nothing notices on its own: the obvious backstop, BrokenPipeError from a
    write to the closed stdout, never fires because emit() DEDUPLICATES and a
    plugin whose state has not changed writes nothing at all.

    os._exit, not sys.exit: this runs on a daemon thread and sys.exit only
    raises SystemExit in the calling thread, while main() sleeps on regardless.
    Every change is written to disk as it happens, so there is no state to lose.
    """
    os._exit(0)


def reader():
    global menu_level
    for line in sys.stdin:
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        kind = ev.get("event")
        if kind == "click":
            menu_level = None
            reload_occurrences()
            emit(menu())
        elif kind == "menu":
            v = ev.get("value") or ""
            fields = ev.get("fields") or {}
            if v == "back":
                menu_level = None
                emit(menu())
            elif v == "manage":
                menu_level = v
                emit(menu())
            elif v == "add":
                draft_load(None)
                menu_level = v
                emit(menu())
            elif v.startswith("m:"):
                draft_load(next((m for m in all_reminders()
                                 if m.get("id") == v[2:]), None))
                menu_level = v
                emit(menu())
            elif v == "addtime":
                # Keep the form as it stands before rebuilding it around the
                # longer list -- see the note in form_rows().
                draft["fields"] = dict(fields)
                add_time(fields)
                emit(menu())
            elif v.startswith("rmtime:"):
                draft["fields"] = dict(fields)
                t = v[len("rmtime:"):]
                draft["times"] = [x for x in draft["times"] if x != t]
                emit(menu())
            elif v.startswith("save:"):
                rid = v[5:] or None
                if save_from_fields(fields, rid):
                    draft_load(None)
                    reload_occurrences()
                    emit(render())
                    menu_level = "manage" if rid else None
                    emit(menu())
                else:
                    # Rejected: keep the form up with what was typed rather
                    # than closing and losing it.
                    emit(menu())
            elif v.startswith("rm:"):
                delete_reminder(v[3:])
                reload_occurrences()
                emit(render())
                menu_level = "manage"
                emit(menu())
            elif v.startswith("d:"):
                menu_level = v[2:]
                emit(menu())
            elif v.startswith(("take:", "skip:", "snooze:", "undo:")):
                verb, key = v.split(":", 1)
                if verb == "snooze":
                    postpone(key)
                elif verb == "undo":
                    clear(key)
                else:
                    mark(key, "done" if verb == "take" else "skipped")
                reload_occurrences()
                emit(render())
                # An empty menu closes the panel, which is right after acting.
                menu_level = None
                emit({"menu": {"item": "", "rows": []}})
    exit_with_the_bar()


def main():
    threading.Thread(target=reader, daemon=True).start()
    while True:
        reload_occurrences()
        emit(render())
        time.sleep(POLL_SECONDS)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
