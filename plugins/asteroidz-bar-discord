#!/usr/bin/env python3
"""Push-to-talk for the official Discord client, on Wayland.

Discord's push-to-talk does not work under a Wayland compositor, and the reason
is specific enough to be worth writing down, because every obvious fix is the
wrong one.

Discord does not use Electron's `globalShortcut` API, and it does not use the
XDG GlobalShortcuts portal. Its keybinds live in its own native module,
`modules/discord_utils-1/discord_utils/discord_utils.node`, which exports
KeybindFired / KeybindServiceReady, links libX11, and uses XOpenDisplay and
XInput2. There is not one portal, GlobalShortcut or zwp_ string in it. So
`--enable-features=GlobalShortcutsPortal` does nothing for Discord: that feature
belongs to the bundled Chromium, which carries it whether Discord calls it or
not.

Two consequences:

  * Run Discord as a native Wayland client and it has no DISPLAY at all -- its
    keybind service has no X server to talk to and is simply inert. Nothing can
    deliver push-to-talk to it, including Discord's own UI.

  * Run it under XWayland and the service connects, but XWayland only receives
    key events while an X surface has focus. Press the key over a Wayland window
    and the X server never hears it.

What DOES work, measured rather than assumed: XTEST injection happens INSIDE the
X server, so an XInput2 raw-event listener sees it regardless of which Wayland
surface holds focus. Verified with `xinput test-xi2 --root` while a native
Wayland window was focused -- RawKeyPress and RawKeyRelease both arrived -- and
then end to end against Discord itself, transmitting in a voice channel with the
focus on a terminal.

So this bridges the two halves:

    asteroidz global shortcut  --(portal Activated/Deactivated)-->  this
    this  --(XTEST fake key into XWayland)-->  Discord's keybind service

Nothing here touches Discord's API. There is no token, no gateway, no voice
code, and no account credential anywhere in this process -- which is the point,
because the daemon this replaces needed all four and that put it against
Discord's terms of service.

REQUIREMENTS
    Discord must run under XWayland, or its keybind service is not listening at
    all. `~/.local/bin/discord-xwayland` does that with --ozone-platform=x11.

    The key Discord is configured to use for push-to-talk must match KEY below,
    and it should be a key you do not otherwise use -- it is injected into the X
    server, so anything focused there sees it too.

CONFIG  ~/.config/asteroidz-bar/discord-ptt.conf, `key = value` per line:
    trigger   what you PRESS               (default F12)
    key       X keysym to INJECT           (default F12)
    shortcut  portal shortcut id           (default push-to-talk)
    app_id    portal application id        (default org.asteroidzman.DiscordPTT)

    The two keys are separate on purpose, and the separation is what makes the
    binding cheap to change. `key` must match what Discord itself is set to, so
    changing it means changing Discord's own keybind as well -- leave it at the
    default and set Discord once. `trigger` is grabbed by asteroidz and consumed
    before any application sees it, so it can be anything, including a chord
    (`Super+V`), and nothing else needs to know.

    The file is watched. An edit takes effect where it lands: a new `key` is
    retargeted in place, a new `trigger` rebinds through the portal. Nothing
    needs restarting, which is also how the pill's menu and the settings window
    make their changes -- both write this file rather than talking to this
    process, so there is one path to get right instead of three.

    Clicking the pill opens that menu; "press a key to rebind" hands over to
    asteroidz's own interactive picker and stores whatever is pressed.

Run as a continuous bar plugin, one JSON object per state change:

    bar {
        modules-right "custom/discord,volume,clock"
        custom "discord" { exec "asteroidz-bar-discord"; continuous true }
    }
"""

import json
import os
import sys
import threading

CONF = os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
    "asteroidz-bar",
    "discord-ptt.conf",
)

DEFAULTS = {
    # What gets INJECTED into the X server. This must match the key Discord is
    # configured to use for push-to-talk.
    "key": "F12",
    # What you actually PRESS. asteroidz grabs this and consumes it, so it never
    # reaches any application directly. Separate from `key` because they answer
    # different questions -- keeping them equal is fine and is the default.
    "trigger": "F12",
    "shortcut": "push-to-talk",
    "app_id": "org.asteroidzman.DiscordPTT",
}


def load_conf():
    cfg = dict(DEFAULTS)
    try:
        with open(CONF, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, _, v = line.partition("=")
                k, v = k.strip(), v.strip()
                if k in cfg and v:
                    cfg[k] = v
    except OSError:
        pass
    return cfg


def save_conf(updates):
    """Rewrite the conf, keeping every line that is not being changed.

    Comments and unrecognised keys survive: this file is hand-editable and
    documented as such, so a menu pick must not silently discard somebody's
    notes to themselves. Keys already present are rewritten in place, which
    keeps the file's order rather than reshuffling it on every save.
    """
    updates = {k: v for k, v in updates.items() if k in DEFAULTS}
    if not updates:
        return
    lines, seen = [], set()
    try:
        with open(CONF, encoding="utf-8") as fh:
            for line in fh:
                line = line.rstrip("\n")
                bare = line.strip()
                k = bare.partition("=")[0].strip()
                if bare and not bare.startswith("#") and "=" in bare \
                        and k in updates:
                    lines.append(f"{k} = {updates[k]}")
                    seen.add(k)
                else:
                    lines.append(line)
    except OSError:
        pass
    for k, v in updates.items():
        if k not in seen:
            lines.append(f"{k} = {v}")
    try:
        os.makedirs(os.path.dirname(CONF), exist_ok=True)
        tmp = CONF + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.write("\n".join(lines).rstrip("\n") + "\n")
        os.replace(tmp, CONF)
    except OSError:
        pass


SHORTCUTS = os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
    "asteroidz",
    "global-shortcuts",
)


def forget_saved(app_id):
    """Drop our line from the compositor's record of picked bindings.

    asteroidz lets a persisted pick OVERRIDE the preferred_trigger an app asks
    for -- deliberately, so that a key the user chose is not undone by the next
    app release. The consequence is that once anything has been picked, writing
    a new `trigger` into our own conf has no effect whatsoever, silently.

    So a trigger set from the conf clears the pick first, and the two can never
    disagree about which one is in force.
    """
    try:
        with open(SHORTCUTS, encoding="utf-8") as fh:
            keep = [ln for ln in fh
                    if ln.split("\t")[0].strip() != app_id]
    except OSError:
        return
    try:
        tmp = SHORTCUTS + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.writelines(keep)
        os.replace(tmp, SHORTCUTS)
    except OSError:
        pass


def read_saved(app_id, shortcut):
    """The trigger the compositor currently has recorded, or None.

    Read from its file rather than guessed from ours: an interactive pick lands
    there and nowhere else, so this is the only way to learn what was chosen.
    """
    try:
        with open(SHORTCUTS, encoding="utf-8") as fh:
            for line in fh:
                parts = line.rstrip("\n").split("\t")
                if len(parts) >= 3 and parts[0] == app_id \
                        and parts[1] == shortcut:
                    return parts[2]
    except OSError:
        pass
    return None


_last = None


def emit(text, cls, tooltip):
    """One line of JSON, and only when something changed.

    The bar redraws on every line it reads, and a redraw is a recomposite on
    every monitor -- which is what made an earlier module cost real CPU while
    displaying nothing new.
    """
    global _last
    obj = {"text": text, "class": cls, "tooltip": tooltip}
    line = json.dumps(obj, sort_keys=True)
    if line == _last:
        return
    _last = line
    sys.stdout.write(line + "\n")
    sys.stdout.flush()
    if _publish:
        # Written for the other monitors' instances to mirror. Via a temp file
        # and rename so a reader never sees half a line -- they are woken by the
        # file monitor the instant this lands.
        try:
            tmp = STATE + ".tmp"
            with open(tmp, "w", encoding="utf-8") as fh:
                fh.write(line)
            os.replace(tmp, STATE)
        except OSError:
            pass


def emit_raw(obj):
    """A line that is NOT state: a menu.

    Separate from emit() for two reasons. emit() deduplicates, so a menu sent
    twice in a row -- which is exactly what opening the same menu again is --
    would be swallowed and the second click would do nothing. And a menu must
    never reach the state file, or the other monitors' instances would mirror it
    and every screen would open a menu because one of them was clicked.
    """
    sys.stdout.write(json.dumps(obj, sort_keys=True) + "\n")
    sys.stdout.flush()


_publish = False


class Injector:
    """XTEST key injection into XWayland.

    The display is opened ONCE and held. Shelling out to xdotool per event would
    fork twice and re-open the X connection each time, on the press that starts
    somebody's sentence.
    """

    def __init__(self, keysym_name):
        from Xlib import XK, display
        from Xlib.ext import xtest

        self._XK = XK
        self._xtest = xtest
        self.disp = display.Display()  # honours DISPLAY
        self.lock = threading.Lock()
        self.keycode = 0
        self.set_key(keysym_name)

    def set_key(self, keysym_name):
        """Retarget without reconnecting.

        Raises rather than half-applying: a name X does not know would otherwise
        leave keycode 0, and injecting that is a keypress the server discards --
        push-to-talk that looks configured and transmits nothing.
        """
        keysym = self._XK.string_to_keysym(keysym_name)
        if keysym == 0:
            raise ValueError(f"unknown keysym: {keysym_name}")
        code = self.disp.keysym_to_keycode(keysym)
        if not code:
            raise ValueError(f"keysym {keysym_name} is not in the X keymap")
        with self.lock:
            self.keycode = code

    def _fake(self, press):
        # X.KeyPress = 2, X.KeyRelease = 3
        with self.lock:
            self._xtest.fake_input(self.disp, 2 if press else 3, self.keycode)
            self.disp.sync()

    def press(self):
        self._fake(True)

    def release(self):
        self._fake(False)


STATE = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "asteroidz-discord-ptt.state"
)
LOCK = STATE + ".lock"
# "Please run the interactive key picker." Only the lock holder has a portal
# session, so only it can ask for one -- but the menu opens on whichever monitor
# was clicked, and half the time that is a mirror. The mirror creates this file
# and the holder, watching for it, does the work and deletes it.
PICK = STATE + ".pick"


def menu_rows(bound, key, leader):
    """The pill's menu: what you press, and what Discord hears.

    Two keys, and keeping them straight is the whole reason this menu exists.

      `trigger` is what YOU press. asteroidz grabs it through the portal and
      consumes it, so no application ever sees it. Change it freely.

      `key` is what gets INJECTED into the X server for Discord's own keybind
      service to hear. It has to equal the key configured inside Discord, so
      changing it means changing Discord's setting too -- which is why it is not
      the one offered first.

    Keeping them separate is what makes the trigger cheap to change: leave `key`
    at the obscure default, set Discord once, and never touch either again.
    """
    return {
        "menu": {
            "rows": [
                {"text": f"Push-to-talk: {bound or 'not bound'}",
                 "enabled": False},
                {"separator": True},
                {"text": "Press a key to rebind…", "value": "ptt:pick"},
                {"separator": True},
                {"text": "Key sent to Discord", "input": True,
                 "value": "key", "edit": key},
                {"text": "Save", "value": "ptt:save"},
            ] + ([] if leader else [
                {"separator": True},
                {"text": "(mirror — the bridge runs on another screen)",
                 "enabled": False},
            ]),
        }
    }


def watch_stdin(on_event, on_eof):
    """The bar's event channel, as a GLib source.

    A blocking `for line in sys.stdin` is what the other plugins use and it
    cannot be used here: this process is a GLib main loop, and a read that parks
    the thread would stop the portal signals that push-to-talk is made of.

    HUP is not decoration. These bridges outlived the bar every time it was
    restarted -- they sit in a main loop and nothing told them the pipe was gone,
    so each restart left two more behind, still holding an X connection. EOF on
    stdin is the bar being gone, and it is unambiguous.
    """
    import gi
    from gi.repository import GLib

    buf = {"text": ""}

    def ready(fd, condition):
        if condition & (GLib.IOCondition.HUP | GLib.IOCondition.ERR):
            on_eof()
            return False
        try:
            chunk = os.read(fd, 65536)
        except OSError:
            on_eof()
            return False
        if not chunk:
            on_eof()
            return False
        buf["text"] += chunk.decode("utf-8", "replace")
        while "\n" in buf["text"]:
            line, _, buf["text"] = buf["text"].partition("\n")
            line = line.strip()
            if not line:
                continue
            try:
                on_event(json.loads(line))
            except ValueError:
                pass
        return True

    # GLibUnix where it exists, GLib where it does not. pygobject moved this and
    # left the old spelling working but warning -- and a plugin's stderr is shown
    # by the bar, so a deprecation notice per instance per start is noise in the
    # one place errors are supposed to stand out.
    try:
        gi.require_version("GLibUnix", "2.0")
        from gi.repository import GLibUnix
        add_fd = GLibUnix.fd_add_full
    except (ValueError, ImportError):
        add_fd = GLib.unix_fd_add_full

    add_fd(
        GLib.PRIORITY_DEFAULT,
        sys.stdin.fileno(),
        GLib.IOCondition.IN | GLib.IOCondition.HUP | GLib.IOCondition.ERR,
        ready,
    )


def claim_lock():
    """Exactly one instance may register and inject.

    The bar runs a continuous plugin once per bar, and there is one bar per
    monitor -- so on two outputs this starts twice. Both instances registered the
    same shortcut and both injected, which put two RawKeyPress and two
    RawKeyRelease into the X server per press. Harmless-looking, and not: the
    FIRST release ends transmission, so with any skew between the two the
    microphone can close while the key is still held.

    An flock rather than a pidfile: it is released by the kernel when the process
    dies, so a killed bar does not leave a stale claim that blocks the next one.
    """
    import fcntl

    fh = open(LOCK, "w")  # noqa: SIM115 -- must outlive this function
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        fh.close()
        return None
    return fh


def follow_state():
    """The instances that did not get the lock still have a pill to draw.

    They mirror the holder's state file instead of registering anything, so every
    monitor shows the same thing and only one of them talks to the portal.

    They are still clickable, though, and must be: the menu opens on the monitor
    the pointer is on. A mirror edits the same two files the holder watches --
    the conf, and the pick request -- so the holder does the work either way and
    there is no second path to keep in step.
    """
    import gi

    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib

    tip = {"text": ""}

    def show():
        try:
            with open(STATE, encoding="utf-8") as fh:
                obj = json.loads(fh.read())
        except (OSError, ValueError):
            return
        tip["text"] = obj.get("tooltip", "")
        emit(obj.get("text", "PTT"), obj.get("class", "idle"), tip["text"])

    show()
    gfile = Gio.File.new_for_path(STATE)
    monitor = gfile.monitor_file(Gio.FileMonitorFlags.NONE, None)
    monitor.connect("changed", lambda *_: show())

    loop = GLib.MainLoop()

    def event(obj):
        # The tooltip the holder published is the only view a mirror has of
        # what is bound; it reads "push-to-talk — F12".
        bound = tip["text"].rpartition("—")[2].strip() or None
        if obj.get("event") == "click":
            emit_raw(menu_rows(bound, load_conf()["key"], leader=False))
        elif obj.get("event") == "menu":
            handle_menu(obj, touch_pick)

    watch_stdin(event, loop.quit)
    loop.run()
    return 0


def touch_pick():
    try:
        with open(PICK, "w", encoding="utf-8"):
            pass
    except OSError:
        pass


def handle_menu(obj, request_pick):
    """One menu pick, from either kind of instance.

    Writing the conf is all a save has to do: the holder watches that file, so
    what happens next follows from the write, not from who made it. That is what
    lets a mirror carry the same menu as the bridge without carrying a second
    copy of its logic.
    """
    action = obj.get("value") or ""
    fields = obj.get("fields") or {}
    if action == "ptt:pick":
        request_pick()
    elif action == "ptt:save":
        key = (fields.get("key") or "").strip()
        if key and key != load_conf()["key"]:
            save_conf({"key": key})
    # Anything else closes the menu, and an empty set is how that is said.
    emit_raw({"menu": {"rows": []}})


def main():
    cfg = load_conf()

    global _publish

    lock = claim_lock()
    if lock is None:
        return follow_state()
    _publish = True

    try:
        injector = Injector(cfg["key"])
    except Exception as exc:  # noqa: BLE001 -- reported, not raised
        emit("PTT", "error", f"cannot inject keys: {exc}")
        # Nothing to retry: a missing DISPLAY or an unmapped keysym does not fix
        # itself, and a loop here would just spin.
        return 1

    import gi

    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib

    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)

    # Own a bus name matching app_id BEFORE talking to the portal.
    #
    # GlobalShortcuts refuses a caller it cannot identify -- "An app id is
    # required" -- and for a host process (not flatpak, not snap) the portal
    # works the app id out from a well-known name the caller owns. A bare script
    # owns nothing, so the very first CreateSession is rejected.
    # Claim an app id, BEFORE any other portal request.
    #
    # Host (non-sandboxed) processes have no app id and GlobalShortcuts refuses
    # them outright -- "An app id is required". Owning a matching D-Bus name does
    # not help, and neither does a systemd app-*.scope; both were tried. The
    # mechanism is org.freedesktop.host.portal.Registry.Register, and it has to
    # come first.
    #
    # The id must resolve to a .desktop file glib can load, and that file's Exec
    # binary must EXIST -- glib returns NULL for a dangling one, after which the
    # portal answers "App info not found" and refuses to bind. That failure costs
    # push-to-talk entirely and shows no other symptom, so the .desktop shipped
    # alongside this points at the real bridge.
    #
    # Re-registering after a portal restart can fail with "already registered".
    # That is not an error worth reporting: the bind below is the real test.
    try:
        bus.call_sync(
            "org.freedesktop.portal.Desktop",
            "/org/freedesktop/portal/desktop",
            "org.freedesktop.host.portal.Registry",
            "Register",
            GLib.Variant("(sa{sv})", (cfg["app_id"], {})),
            None,
            Gio.DBusCallFlags.NONE,
            -1,
            None,
        )
    except GLib.Error as exc:
        if "already" not in (exc.message or "").lower():
            emit("PTT", "error", f"could not register app id: {exc.message}")

    state = {"held": False, "bound": None, "session": None,
             "want": cfg["trigger"], "seq": 0}

    def show():
        if state["bound"] is None:
            emit("PTT", "error", "push-to-talk is not bound")
        elif state["held"]:
            emit("PTT", "active", f"transmitting — {state['bound']}")
        else:
            emit("PTT", "idle", f"push-to-talk — {state['bound']}")

    def on_signal(_conn, _sender, _path, _iface, signal, params):
        # (o session, s shortcut_id, t timestamp, a{sv} options)
        try:
            shortcut = params.unpack()[1]
        except (IndexError, TypeError, AttributeError):
            return
        if shortcut != cfg["shortcut"]:
            return
        if signal == "Activated":
            state["held"] = True
            injector.press()
        elif signal == "Deactivated":
            state["held"] = False
            injector.release()
        else:
            return
        show()

    # The FRONTEND interface, not org.freedesktop.impl.portal.*. The impl one is
    # the contract between xdg-desktop-portal and the compositor; a client that
    # listens there is reading someone else's mail and gets nothing routed to it.
    PORTAL = "org.freedesktop.portal.Desktop"
    OBJ = "/org/freedesktop/portal/desktop"
    IFACE = "org.freedesktop.portal.GlobalShortcuts"

    for sig in ("Activated", "Deactivated"):
        bus.signal_subscribe(
            PORTAL, IFACE, sig, OBJ, None, Gio.DBusSignalFlags.NONE, on_signal
        )

    # ── register the shortcut ───────────────────────────────────────────────
    #
    # Both calls are asynchronous in the portal sense: they return a Request
    # object path immediately and deliver the real answer as a Response signal on
    # it. Subscribing AFTER the call would race, so each subscription goes up
    # first.
    def call(method, args, on_response):
        req = None

        def handler(_c, _s, path, _i, _sig, params):
            if path != req:
                return
            # .unpack() -- the callback hands over a GLib.Variant tuple, and
            # indexing it yields Variants, not the dict this needs.
            code, results = params.unpack()
            if code != 0:
                emit("PTT", "error", f"{method} refused by the portal (code {code})")
                return
            on_response(results)

        sub = bus.signal_subscribe(
            None,
            "org.freedesktop.portal.Request",
            "Response",
            None,
            None,
            Gio.DBusSignalFlags.NONE,
            handler,
        )
        try:
            ret = bus.call_sync(
                PORTAL, OBJ, IFACE, method, args, GLib.VariantType("(o)"),
                Gio.DBusCallFlags.NONE, -1, None,
            )
            req = ret.unpack()[0]
        except GLib.Error as exc:
            bus.signal_unsubscribe(sub)
            emit("PTT", "error", f"{method} failed: {exc.message}")

    def bound(_results):
        state["bound"] = read_saved(cfg["app_id"], cfg["shortcut"]) \
            or cfg["trigger"]
        show()

    def session_ready(results):
        session = results.get("session_handle")
        if not session:
            emit("PTT", "error", "portal gave no session handle")
            return
        state["session"] = session
        # A plain tuple, NOT a pre-built GLib.Variant. PyGObject constructs the
        # whole nested signature from native Python types, and handing it a
        # Variant where it expects the raw value fails inside its own builder
        # with "Expected GLib.Variant, but got str" -- pointing at the innermost
        # string rather than at the wrapper that caused it. Only the a{sv} values
        # are Variants, because `v` genuinely means variant.
        shortcut = (
            cfg["shortcut"],
            {
                "description": GLib.Variant("s", "Discord push-to-talk"),
                "preferred_trigger": GLib.Variant("s", state["want"]),
            },
        )
        call(
            "BindShortcuts",
            GLib.Variant("(oa(sa{sv})sa{sv})", (session, [shortcut], "", {})),
            bound,
        )

    def register(trigger):
        """(Re)bind, with `trigger` as the preference.

        An empty string is the documented way to ask asteroidz for its
        interactive picker: it skips any saved binding and prompts for a key,
        which is what "press a key to rebind" is.

        A fresh session each time. BindShortcuts replaces the session's whole
        shortcut list, but the portal identifies a session by its handle token
        and reusing one across a rebind left the old grab in place on every
        implementation worth worrying about -- closing first is a line of code
        and removes the question.
        """
        state["want"] = trigger
        old = state.pop("session", None)
        if old:
            try:
                bus.call_sync(PORTAL, old, "org.freedesktop.portal.Session",
                              "Close", None, None, Gio.DBusCallFlags.NONE,
                              -1, None)
            except GLib.Error:
                pass
        tok = "asteroidz_ptt_%d_%d" % (os.getpid(), state["seq"])
        state["seq"] += 1
        call(
            "CreateSession",
            GLib.Variant(
                "(a{sv})",
                (
                    {
                        "handle_token": GLib.Variant("s", tok),
                        "session_handle_token": GLib.Variant("s", tok),
                    },
                ),
            ),
            session_ready,
        )

    # The picker's answer arrives here, not as a reply to BindShortcuts: the
    # compositor replies to the bind immediately and only then puts the overlay
    # up, so the chosen key comes back as ShortcutsChanged. Waiting on the bind
    # reply instead would report the old binding every time.
    def on_changed(_c, _s, _p, _i, _sig, _params):
        picked = read_saved(cfg["app_id"], cfg["shortcut"])
        if picked:
            state["bound"] = picked
            if picked != cfg["trigger"]:
                # In this order. The write below wakes the conf watcher, which
                # rebinds when it finds a trigger it has not seen -- so updating
                # cfg FIRST is what stops a pick from immediately tearing down
                # the session it just created and clearing the record it just
                # made. Written back at all so the two files agree: they are read
                # by different code at different times, and a pick living in only
                # one of them gets undone by whatever reads the other.
                cfg["trigger"] = picked
                save_conf({"trigger": picked})
        show()

    bus.signal_subscribe(PORTAL, IFACE, "ShortcutsChanged", OBJ, None,
                         Gio.DBusSignalFlags.NONE, on_changed)

    register(cfg["trigger"])
    show()

    # A release we never see would leave the key latched down in the X server,
    # which is a stuck microphone. Belt and braces on the way out.
    def cleanup():
        if state["held"]:
            try:
                injector.release()
            except Exception:  # noqa: BLE001
                pass

    loop = GLib.MainLoop()

    # ── reacting to edits ───────────────────────────────────────────────────
    #
    # The conf is the single channel. The settings window writes it, the pill
    # menu writes it, a text editor writes it, and all three arrive here as the
    # same event -- so there is one path to get right rather than three, and
    # hand-editing keeps working exactly as the docstring promises.
    def conf_changed(*_):
        new = load_conf()
        if new["key"] != cfg["key"]:
            try:
                injector.set_key(new["key"])
                cfg["key"] = new["key"]
            except Exception as exc:  # noqa: BLE001 -- shown, not raised
                # Keep injecting the old key. A bad name in the file is a typo,
                # and a silent switch to injecting nothing would look like
                # Discord had broken.
                emit("PTT", "error", f"cannot use key '{new['key']}': {exc}")
                return
        if new["trigger"] != cfg["trigger"]:
            cfg["trigger"] = new["trigger"]
            # A picked binding outranks preferred_trigger, so a trigger set here
            # would be ignored while one is on record. Clear it: an explicit
            # write is the more recent intent.
            forget_saved(cfg["app_id"])
            register(cfg["trigger"])
        show()

    conf_file = Gio.File.new_for_path(CONF)
    conf_monitor = conf_file.monitor_file(Gio.FileMonitorFlags.NONE, None)
    conf_monitor.connect("changed", conf_changed)

    # A mirror asking for the picker. Only this instance has a portal session,
    # so the request travels as a file and is consumed here.
    def pick_requested(*_):
        if not os.path.exists(PICK):
            return
        try:
            os.unlink(PICK)
        except OSError:
            pass
        start_pick()

    def start_pick():
        forget_saved(cfg["app_id"])
        register("")  # empty preferred_trigger == "prompt me"

    pick_file = Gio.File.new_for_path(PICK)
    pick_monitor = pick_file.monitor_file(Gio.FileMonitorFlags.NONE, None)
    pick_monitor.connect("changed", pick_requested)

    def event(obj):
        if obj.get("event") == "click":
            emit_raw(menu_rows(state["bound"], cfg["key"], leader=True))
        elif obj.get("event") == "menu":
            handle_menu(obj, start_pick)

    watch_stdin(event, loop.quit)

    try:
        loop.run()
    except KeyboardInterrupt:
        pass
    finally:
        cleanup()
    return 0


if __name__ == "__main__":
    sys.exit(main())
